{
  "name": "@agent-gate-contract/validator",
  "version": "0.2.0",
  "private": true,
  "description": "Validates Agent Gate Contract responses and chains: the JSON Schema plus the rules a schema cannot express.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "prepack": "node -e \"const fs=require('node:fs');fs.mkdirSync('schema',{recursive:true});fs.copyFileSync('../../schema/agc.schema.json','schema/agc.schema.json')\"",
    "postpack": "node -e \"require('node:fs').rmSync('schema',{recursive:true,force:true})\""
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
