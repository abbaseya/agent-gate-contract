{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abbaseya/agent-gate-contract/schema/agc.schema.json",
  "title": "Agent Gate Contract response",
  "description": "The answer a gate gives an AI agent. Version 0.1. See SPEC.md for the rules a schema cannot express.",
  "type": "object",
  "required": ["agc", "gate", "subject", "verdict", "coverage", "attempt"],
  "additionalProperties": false,
  "properties": {
    "agc": { "const": "0.1" },
    "gate": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["deterministic", "judgment"] },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "subject": {
      "type": "object",
      "required": ["kind", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["tool-call", "diff", "commit", "artifact", "pull-request", "session"] },
        "fingerprint": { "type": "string", "minLength": 8 },
        "scope": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "verdict": { "enum": ["allow", "repaired", "block", "escalate"] },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "coverage": {
      "type": "object",
      "required": ["complete", "classes"],
      "additionalProperties": false,
      "properties": {
        "complete": { "type": "boolean" },
        "classes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "not_checked": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "attempt": {
      "type": "object",
      "required": ["n", "budget"],
      "additionalProperties": false,
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "budget": { "type": "integer", "minimum": 1 }
      }
    },
    "carried": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "enum": ["repaired", "block", "escalate"] } } },
      "then": { "required": ["findings"], "properties": { "findings": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "class", "location", "what", "why", "severity", "status", "remedy", "check"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "class": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "what": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["blocking", "advisory"] },
        "status": { "enum": ["new", "still-open", "regressed"] },
        "remedy": { "$ref": "#/$defs/remedy" },
        "check": { "$ref": "#/$defs/check" }
      }
    },
    "remedy": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["rewrite", "generate", "patch", "command", "delegate", "decide"] },
        "applied": { "type": "boolean" },
        "input": { "type": "object" },
        "tool": { "type": "string", "minLength": 1 },
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "find", "replace"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "find": { "type": "string", "minLength": 1 },
              "replace": { "type": "string" }
            }
          }
        },
        "run": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "ask": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "rewrite" } } }, "then": { "required": ["input"] } },
        { "if": { "properties": { "kind": { "const": "generate" } } }, "then": { "required": ["tool"] } },
        { "if": { "properties": { "kind": { "const": "patch" } } }, "then": { "required": ["edits"] } },
        { "if": { "properties": { "kind": { "const": "command" } } }, "then": { "required": ["run"] } },
        { "if": { "properties": { "kind": { "const": "delegate" } } }, "then": { "required": ["role"] } },
        { "if": { "properties": { "kind": { "const": "decide" } } }, "then": { "required": ["ask", "options"] } }
      ]
    },
    "check": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["command", "preview", "condition"] },
        "run": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "command" } } }, "then": { "required": ["run"] } },
        { "if": { "properties": { "kind": { "const": "condition" } } }, "then": { "required": ["condition"] } }
      ]
    }
  }
}
